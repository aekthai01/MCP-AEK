#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT"

if [[ ! -x .venv/bin/aek ]]; then
  echo 'MCP-AEK is not installed yet. Run: bash scripts/install-termux.sh' >&2
  exit 1
fi

# Termux/Android + recent CPython can successfully build cryptography's Rust
# extension yet fail to import it because Android's loader does not make the
# libpython C-API symbols visible to the extension (for example PyModule_Type).
# Preloading the matching libpython fixes that runtime linker issue. Keep this
# scoped to Termux so normal Linux/macOS environments are untouched.
if [[ -n "${PREFIX:-}" && "$PREFIX" == /data/data/com.termux/* ]]; then
  PY_VER="$(.venv/bin/python -c 'import sys; print(f"{sys.version_info.major}.{sys.version_info.minor}")')"
  LIBPYTHON="$PREFIX/lib/libpython${PY_VER}.so"
  if [[ -f "$LIBPYTHON" ]]; then
    case ":${LD_PRELOAD:-}:" in
      *":$LIBPYTHON:"*) ;;
      *)
        if [[ -n "${LD_PRELOAD:-}" ]]; then
          export LD_PRELOAD="$LIBPYTHON:$LD_PRELOAD"
        else
          export LD_PRELOAD="$LIBPYTHON"
        fi
        ;;
    esac
  fi
fi

exec .venv/bin/aek "$@"
